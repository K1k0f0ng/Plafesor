# Copia este archivo como .env y rellena los valores reales

# Configuración del servidor
PORT=3001
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=playfesor_playfesor
DB_USER=playfesor
DB_PASSWORD=TU_PASSWORD_AQUI

# JWT (cambia esto por una cadena secreta muy larga, ej. crypto.randomBytes(64).toString('hex'))
JWT_SECRET=cambia_este_secreto_por_uno_muy_largo_y_seguro
JWT_EXPIRES_IN=8h

# CORS (dominios permitidos, separados por coma)
CORS_ORIGINS=http://localhost:3000

# Inteligencia artificial (Copiloto, Observador, Tutor IA, generación de actividades, PMI)
ANTHROPIC_API_KEY=TU_CLAVE_ANTHROPIC_AQUI
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Email (reset de contraseña) — SMTP genérico, cualquier proveedor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Playfesor <no-reply@tu-dominio.com>"

# WhatsApp (notificaciones a padres/directores) — proveedor UltraMsg
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# URL pública del frontend (usada en enlaces de email)
FRONTEND_URL=http://localhost:3000
