# Copia este archivo como .env y rellena los valores reales de ESTE colegio.
# Cada instalación tiene su propio .env — nunca se comparte entre colegios.

# Identidad de la institución (ver checklists/CHECKLIST_DATOS_INSTITUCIONALES.md)
INSTITUCION_NOMBRE=NOMBRE_DEL_COLEGIO
INSTITUCION_DOMINIO=midominio.edu.co
INSTITUCION_EMAIL_CONTACTO=contacto@midominio.edu.co
# Colores de marca institucional usados en los correos automáticos (formato hex)
EMAIL_COLOR_PRIMARIO=#667eea
EMAIL_COLOR_SECUNDARIO=#764ba2

# Configuración del servidor
PORT=3001
NODE_ENV=production

# Base de datos (propia de este colegio, nunca compartida)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=TU_BASE_DE_DATOS_AQUI
DB_USER=TU_USUARIO_BD_AQUI
DB_PASSWORD=TU_PASSWORD_AQUI

# JWT (genera uno único por instalación, ej. crypto.randomBytes(64).toString('hex'))
JWT_SECRET=cambia_este_secreto_por_uno_muy_largo_y_seguro
JWT_EXPIRES_IN=8h

# CORS (dominio del frontend de este colegio, separados por coma si hay varios)
CORS_ORIGINS=https://midominio.edu.co

# Inteligencia artificial (Copiloto, Observador, Tutor IA, generación de actividades, PMI)
ANTHROPIC_API_KEY=TU_CLAVE_ANTHROPIC_AQUI
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Email (reset de contraseña) — SMTP genérico, cualquier proveedor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NOMBRE_DEL_COLEGIO <no-reply@midominio.edu.co>"

# WhatsApp (notificaciones a padres/directores) — proveedor UltraMsg, cuenta propia de este colegio
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# URL pública del frontend de este colegio (usada en enlaces de email)
FRONTEND_URL=https://midominio.edu.co
